VIDEO_PROVIDER=agora
# Comma-separated providers available for selection in the client.
# VIDEO_PROVIDERS=agora,daily,livekit,jitsi
PORT=5000
CLIENT_URL=http://localhost:5173

# Required only when Agora is listed in VIDEO_PROVIDERS.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Uncomment only when Daily is listed in VIDEO_PROVIDERS.
# DAILY_API_KEY=

# Uncomment only when LiveKit is listed in VIDEO_PROVIDERS.
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Optional Jitsi domain (default: meet.jit.si)
# JITSI_DOMAIN=meet.jit.si
